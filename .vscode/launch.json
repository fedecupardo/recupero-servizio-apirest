  "version": "0.2.0",
  "configurations": [
    {
      // Avvia il browser dopo avere lanciato il server Angular.
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    },
    {
      // Apre nel browser la pagina del runner dei test Angular.
      "name": "ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html"
    }
  ]
}
